# Local Compose configuration. Copy to .env; never commit the real .env file.
EXCHANGE_IMAGE=microsserv52-exchange:local

# Provider configuration. Defaults to the local provider mock.
EXCHANGE_PROVIDER_URL=http://provider:8080
EXCHANGE_PROVIDER_API_KEY=
EXCHANGE_PROVIDER_REQUIRES_API_KEY=false
EXCHANGE_PROVIDER_VERSION=v1
EXCHANGE_PROVIDER_TIMEOUT_SECONDS=2
EXCHANGE_PROVIDER_RETRIES=1
EXCHANGE_PROVIDER_MAX_CONCURRENCY=20
EXCHANGE_PROVIDER_SPREAD_BPS=0

# Mock provider mode. Values: ok, error, timeout, malformed, rate_limit, unsupported.
MOCK_MODE=ok

# Shared HS256 secret. Exchange validates tokens signed by Auth or the local CLI.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=
JWT_AUDIENCE=

# Local Redis. Caching is disabled by default until it is verified in the target
# environment. Set CACHE_ENABLED=true to exercise the cache locally.
EXCHANGE_REDIS_PORT=6381

# Published host port for the local provider mock.
EXCHANGE_PROVIDER_PORT=8082
CACHE_ENABLED=false
CACHE_TTL_SECONDS=60

# Published host ports.
EXCHANGE_PORT=8080

LOG_LEVEL=INFO
